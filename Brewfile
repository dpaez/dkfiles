tap "docker/tap"

# --- Shell & CLI ---
brew "bat"            # cat with syntax highlighting
brew "diff-so-fancy"  # git pager (see git/gitconfig)
brew "direnv"         # per-directory env vars (e.g. GH_TOKEN for work repos)
brew "eza"            # modern ls (maintained fork of exa)
brew "gh"
brew "gnupg"          # commit signing
brew "htop"
brew "neovim"
brew "ripgrep"        # fast search: :grep, ctrlsf.vim

# --- Language servers (Neovim built-in LSP, see nvim/lua/lsp.lua) ---
brew "typescript-language-server"   # ts_ls
brew "typescript"
brew "vscode-langservers-extracted" # eslint (also html, css, json)

# --- Cloud & infra ---
brew "aws-sam-cli"
brew "awscli"
brew "cfn-lint"
brew "k6"
brew "mkcert"

# --- Apps ---
cask "ghostty"
cask "font-lilex"
